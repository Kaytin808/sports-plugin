# Local web server
PORT=2323
TIME_ZONE=America/Phoenix
# Set this when the add-on is reached through a reverse proxy, for example:
# PUBLIC_URL=https://sports.example.com
PUBLIC_URL=

# Strongly recommended for any public/cloud deployment. Use 16-128 characters
# containing only letters, numbers, underscores, and hyphens.
ACCESS_TOKEN=

# Your own authorized Xtream subscription. Never commit the real .env file.
XTREAM_BASE_URL=http://provider.example:8080
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# Recommended: paste the numeric category IDs that contain MLB/baseball events.
# Leave blank for automatic category-name discovery on the first request.
XTREAM_BASEBALL_CATEGORY_IDS=
XTREAM_CATEGORY_IDS_BASEBALL=
XTREAM_CATEGORY_IDS_NFL=
XTREAM_CATEGORY_IDS_COLLEGE_FOOTBALL=
XTREAM_CATEGORY_IDS_NBA=
XTREAM_CATEGORY_IDS_WNBA=
XTREAM_CATEGORY_IDS_HOCKEY=
XTREAM_CATEGORY_IDS_SOCCER=
XTREAM_CATEGORY_IDS_GOLF=
XTREAM_CATEGORY_IDS_UFC=
XTREAM_CATEGORY_IDS_F1=
XTREAM_CATEGORY_IDS_TENNIS=

# Most providers accept m3u8; change to ts if your provider requires it.
XTREAM_OUTPUT_EXTENSION=m3u8

# Optional tuning
SCHEDULE_CACHE_SECONDS=300
XTREAM_CACHE_SECONDS=300
EPG_CONCURRENCY=8
MATCH_MIN_SCORE=55
STREAM_PROBE_TIMEOUT_MS=8000
STREAM_PROBE_LIMIT=6
STREAM_PROBE_CONCURRENCY=3
STREAM_PROBE_CACHE_SECONDS=60
